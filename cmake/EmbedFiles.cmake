# Embeds data/migrations/*.sql into a generated C++ source (as::db::embeddedMigrations()).
# Files must be named NNNN_<name>.sql; NNNN becomes the schema version.
function(as_embed_migrations out_var)
  file(GLOB AS_MIGRATION_FILES CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/data/migrations/*.sql)
  list(SORT AS_MIGRATION_FILES)
  set(entries "")
  foreach(f IN LISTS AS_MIGRATION_FILES)
    get_filename_component(name ${f} NAME)
    string(SUBSTRING ${name} 0 4 num)
    if(NOT num MATCHES "^[0-9][0-9][0-9][0-9]$")
      message(FATAL_ERROR "Migration ${name} must start with a 4-digit version")
    endif()
    math(EXPR version "${num}")
    file(READ ${f} sql)
    string(FIND "${sql}" ")AS_SQL\"" bad)
    if(NOT bad EQUAL -1)
      message(FATAL_ERROR "Migration ${name} contains the raw-string delimiter")
    endif()
    string(APPEND entries "    {${version}, \"${name}\", R\"AS_SQL(${sql})AS_SQL\"},\n")
  endforeach()
  set(out ${CMAKE_BINARY_DIR}/generated/embedded_migrations.cpp)
  set(content "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#include \"db/migrations.hpp\"\n\nnamespace as::db {\nnamespace {\nconstexpr Migration MIGRATIONS[] = {\n${entries}};\n}  // namespace\n\nstd::span<const Migration> embeddedMigrations() { return MIGRATIONS; }\n\n}  // namespace as::db\n")
  file(CONFIGURE OUTPUT ${out} CONTENT "${content}" @ONLY)
  set(${out_var} ${out} PARENT_SCOPE)
endfunction()
