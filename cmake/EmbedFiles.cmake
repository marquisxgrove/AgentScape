# Embeds data files into generated C++ sources so the binary is self-contained (desktop and web).
#   as_embed_migrations(out): data/migrations/NNNN_<name>.sql -> as::db::embeddedMigrations()
#   as_embed_seed(out):       data/seed/*.json                -> as::db::embeddedSeedFiles()

function(_as_raw_literal path out_var)
  file(READ ${path} content)
  string(FIND "${content}" ")AS_EMBED\"" bad)
  if(NOT bad EQUAL -1)
    message(FATAL_ERROR "${path} contains the raw-string delimiter )AS_EMBED\"")
  endif()
  set(${out_var} "R\"AS_EMBED(${content})AS_EMBED\"" PARENT_SCOPE)
endfunction()

function(as_embed_migrations out_var)
  file(GLOB files CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/data/migrations/*.sql)
  list(SORT files)
  set(entries "")
  foreach(f IN LISTS files)
    get_filename_component(name ${f} NAME)
    string(SUBSTRING ${name} 0 4 num)
    if(NOT num MATCHES "^[0-9][0-9][0-9][0-9]$")
      message(FATAL_ERROR "Migration ${name} must start with a 4-digit version")
    endif()
    math(EXPR version "${num}")
    _as_raw_literal(${f} literal)
    string(APPEND entries "    {${version}, \"${name}\", ${literal}},\n")
  endforeach()
  set(out ${CMAKE_BINARY_DIR}/generated/embedded_migrations.cpp)
  file(CONFIGURE OUTPUT ${out} CONTENT "// Generated by cmake/EmbedFiles.cmake. Do not edit.
#include \"db/migrations.hpp\"

namespace as::db {
namespace {
constexpr Migration MIGRATIONS[] = {
${entries}};
}  // namespace

std::span<const Migration> embeddedMigrations() { return MIGRATIONS; }

}  // namespace as::db
" @ONLY)
  set(${out_var} ${out} PARENT_SCOPE)
endfunction()

function(as_embed_seed out_var)
  file(GLOB files CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/data/seed/*.json)
  list(SORT files)
  set(entries "")
  foreach(f IN LISTS files)
    get_filename_component(name ${f} NAME)
    _as_raw_literal(${f} literal)
    string(APPEND entries "    {\"${name}\", ${literal}},\n")
  endforeach()
  if(entries STREQUAL "")
    message(FATAL_ERROR "data/seed/ has no JSON files")
  endif()
  set(out ${CMAKE_BINARY_DIR}/generated/embedded_seed.cpp)
  file(CONFIGURE OUTPUT ${out} CONTENT "// Generated by cmake/EmbedFiles.cmake. Do not edit.
#include \"db/seed_loader.hpp\"

namespace as::db {
namespace {
constexpr SeedFile SEED_FILES[] = {
${entries}};
}  // namespace

std::span<const SeedFile> embeddedSeedFiles() { return SEED_FILES; }

}  // namespace as::db
" @ONLY)
  set(${out_var} ${out} PARENT_SCOPE)
endfunction()
