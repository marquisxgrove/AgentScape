# Embeds data files into generated C++ sources so the binary is self-contained (desktop and web).
#   as_embed_migrations(out): data/migrations/NNNN_<name>.sql -> as::db::embeddedMigrations()
#   as_embed_seed(out):       data/seed/*.json                -> as::db::embeddedSeedFiles()

# Emits the file as a char array of byte escapes rather than a string literal: MSVC caps a single
# string literal at ~16 KB (C2026) and a concatenated one at 64 KB, and the seed data exceeds both.
# Arrays have no such limit, and raw bytes sidestep source-encoding differences between compilers.
#   out_decl: "constexpr char <id>[] = {...};"   out_ref: a std::string_view expression over it
function(_as_embed_bytes path id out_decl out_ref)
  file(READ ${path} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
  string(REGEX REPLACE "(('\\\\x..',){24})" "\\1\n    " bytes "${bytes}")
  # Trailing NUL keeps the array non-empty for empty files; the view excludes it.
  set(${out_decl} "constexpr char ${id}[] = {\n    ${bytes}'\\0'};\n" PARENT_SCOPE)
  set(${out_ref} "std::string_view(${id}, sizeof(${id}) - 1)" PARENT_SCOPE)
endfunction()

function(as_embed_migrations out_var)
  file(GLOB files CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/data/migrations/*.sql)
  list(SORT files)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${files})
  set(decls "")
  set(entries "")
  set(i 0)
  foreach(f IN LISTS files)
    get_filename_component(name ${f} NAME)
    string(SUBSTRING ${name} 0 4 num)
    if(NOT num MATCHES "^[0-9][0-9][0-9][0-9]$")
      message(FATAL_ERROR "Migration ${name} must start with a 4-digit version")
    endif()
    math(EXPR version "${num}")
    _as_embed_bytes(${f} "MIGRATION_${i}" decl ref)
    string(APPEND decls "${decl}")
    string(APPEND entries "    {${version}, \"${name}\", ${ref}},\n")
    math(EXPR i "${i} + 1")
  endforeach()
  set(out ${CMAKE_BINARY_DIR}/generated/embedded_migrations.cpp)
  file(CONFIGURE OUTPUT ${out} CONTENT "// Generated by cmake/EmbedFiles.cmake. Do not edit.
#include \"db/migrations.hpp\"

namespace as::db {
namespace {
${decls}
constexpr Migration MIGRATIONS[] = {
${entries}};
}  // namespace

std::span<const Migration> embeddedMigrations() { return MIGRATIONS; }

}  // namespace as::db
" @ONLY)
  set(${out_var} ${out} PARENT_SCOPE)
endfunction()

function(as_embed_seed out_var)
  file(GLOB files CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/data/seed/*.json)
  list(SORT files)
  # Re-run configure when file CONTENT changes too (CONFIGURE_DEPENDS only notices added/removed files).
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${files})
  set(decls "")
  set(entries "")
  set(i 0)
  foreach(f IN LISTS files)
    get_filename_component(name ${f} NAME)
    _as_embed_bytes(${f} "SEED_${i}" decl ref)
    string(APPEND decls "${decl}")
    string(APPEND entries "    {\"${name}\", ${ref}},\n")
    math(EXPR i "${i} + 1")
  endforeach()
  if(entries STREQUAL "")
    message(FATAL_ERROR "data/seed/ has no JSON files")
  endif()
  set(out ${CMAKE_BINARY_DIR}/generated/embedded_seed.cpp)
  file(CONFIGURE OUTPUT ${out} CONTENT "// Generated by cmake/EmbedFiles.cmake. Do not edit.
#include \"db/seed_loader.hpp\"

namespace as::db {
namespace {
${decls}
constexpr SeedFile SEED_FILES[] = {
${entries}};
}  // namespace

std::span<const SeedFile> embeddedSeedFiles() { return SEED_FILES; }

}  // namespace as::db
" @ONLY)
  set(${out_var} ${out} PARENT_SCOPE)
endfunction()
